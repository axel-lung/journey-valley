# Path to the SQLite database file (defaults to ./data/journey-valley.db)
DATABASE_PATH=./data/journey-valley.db

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-secret-change-me

# Live flight search (optional). Without these the app uses its offline
# estimates, which are clearly labelled as such in the interface.
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_ENV=test

# Shared secret for the scheduled price-watch sweep. Until it is set,
# POST /api/watches/check refuses to run.
# WATCH_CRON_SECRET=
